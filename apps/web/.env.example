# Copy to .env.local for local development. Never commit a real .env.local file.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk (dashboard.clerk.com). NEXT_PUBLIC_ prefix is required ONLY for the publishable key --
# CLERK_SECRET_KEY must never carry that prefix, or it would ship the secret into the browser
# bundle. See ADR-029 (docs/architecture/029-clerk-identity-mapping-and-provisioning.md).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
