# Copy to .env.local for local development. Never commit a real .env file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# packages/database -- see packages/database/.env.example for the canonical DATABASE_URL contract
DATABASE_URL=postgresql://user:password@localhost:5432/novalight?schema=public

# Optional -- unset means apps/api/src/auth/in-memory-auth-provider.ts stays active (default).
# See docs/security/022-authentication-production-strategy.md. Get a real value from a Clerk
# development instance (dashboard.clerk.com) -- never commit a real key.
CLERK_SECRET_KEY=

# Optional -- unset means the Clerk webhook route rejects every request. Get a real value from
# the webhook endpoint's settings in the Clerk dashboard once configured. See ADR-029
# (docs/architecture/029-clerk-identity-mapping-and-provisioning.md) -- never commit a real key.
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional -- defaults to true (today's behavior: unprovisioned users are created immediately
# on first successful token verification). Set to false to require the webhook to provision a
# User row first. See ADR-029.
ENABLE_JIT_PROVISIONING=true
