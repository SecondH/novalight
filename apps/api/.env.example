# Copy to .env.local for local development. Never commit a real .env file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# packages/database -- see packages/database/.env.example for the canonical DATABASE_URL contract
DATABASE_URL=postgresql://user:password@localhost:5432/novalight?schema=public

# Optional -- unset means apps/api/src/auth/in-memory-auth-provider.ts stays active (default).
# See docs/security/022-authentication-production-strategy.md. Get a real value from a Clerk
# development instance (dashboard.clerk.com) -- never commit a real key.
CLERK_SECRET_KEY=
