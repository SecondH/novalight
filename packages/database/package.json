{
  "name": "@novalight/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma-based database access layer. User (Phase 0) plus Account/Brand/ContentIdea/ContentDraft/CalendarEntry (M1, ADR-018 v1.2) -- see prisma/schema.prisma.",
  "main": "src/client.ts",
  "types": "src/client.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet -- packages/database has no logic beyond the generated client\" && exit 0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
